# Copy to cloud-gateway.env and fill in the two server publish addresses.
# Do not commit the real file if the URL contains an authentication token.
FFMPEG_PATH=ffmpeg
STATION_SOURCE_URL=rtsp://192.168.1.202:8554/station
DRONE_SOURCE_URL=rtsp://192.168.1.123:8554/rescue
# Example only. Retrieve the real username and password from the server's
# /etc/scenic-video/publish.env file; never commit real values here.
CLOUD_STATION_PUBLISH_URL=rtmp://relay:CHANGE_ME@YOUR_SERVER_PUBLIC_IP:1935/station
CLOUD_DRONE_PUBLISH_URL=rtmp://relay:CHANGE_ME@YOUR_SERVER_PUBLIC_IP:1935/drone
