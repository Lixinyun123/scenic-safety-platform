# Copy to cloud-gateway.env and fill in the two server publish addresses.
# Do not commit the real file if the URL contains an authentication token.
FFMPEG_PATH=ffmpeg
STATION_SOURCE_URL=rtsp://192.168.1.202:8554/station
DRONE_SOURCE_URL=rtsp://192.168.1.123:8554/rescue
CLOUD_STATION_PUBLISH_URL=
CLOUD_DRONE_PUBLISH_URL=
