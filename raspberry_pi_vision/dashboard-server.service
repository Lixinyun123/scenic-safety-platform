[Unit]
Description=Independent Rescue Dashboard Web Server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=znfxq
Group=znfxq
WorkingDirectory=/home/znfxq/raspberry_pi_vision
EnvironmentFile=-/etc/water-person-detector.env
EnvironmentFile=-/home/znfxq/raspberry_pi_vision/dashboard-server.env
ExecStart=/usr/bin/python3 -u /home/znfxq/raspberry_pi_vision/dashboard_server.py --host 0.0.0.0 --port 8080 --output /home/znfxq/raspberry_pi_vision/output
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/znfxq/raspberry_pi_vision/output

[Install]
WantedBy=multi-user.target
